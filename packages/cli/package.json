{
  "name": "@godown/cli",
  "version": "0.3.0",
  "description": "A CLI for building package",
  "type": "module",
  "scripts": {
    "build": "node src/main.ts b -c .godownrc.json",
    "check-types": "tsc --noEmit",
    "run-dist": "node build/main.js"
  },
  "dependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/pluginutils": "^5.5.1",
    "@web/rollup-plugin-html": "^4.0.0",
    "autoprefixer": "^10.6.2",
    "cem-plugin-define": "workspace:^",
    "commander": "^15.1.0",
    "custom-element-jet-brains-integration": "^1.8.0",
    "custom-element-vs-code-integration": "^1.5.0",
    "fast-glob": "^3.3.3",
    "get-tsconfig": "^4.14.3",
    "globby": "^16.2.4",
    "jsonc-parser": "^3.3.1",
    "oxc-transform": "^0.158.0",
    "postcss": "^8.5.32",
    "postcss-csso": "^6.0.1",
    "postcss-load-config": "^6.0.1",
    "rollup-plugin-minify-html-parts": "workspace:^",
    "rollup-plugin-oxc": "^0.9.0",
    "rollup-plugin-template-replace": "workspace:^",
    "semver": "^7.8.6",
    "sharekit": "^1.3.0",
    "typescript": "^6.0.3",
    "typescript545": "npm:typescript@5.4.5"
  },
  "devDependencies": {
    "rolldown": "^1.3.1",
    "rollup": "^4.68.2"
  },
  "peerDependencies": {
    "rolldown": "^1.0.0-0 || ^1.0.0",
    "rollup": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "rolldown": {
      "optional": true
    },
    "rollup": {
      "optional": true
    }
  },
  "bin": {
    "godown": "build/main.js"
  },
  "exports": {
    "./src/*": "./src/*",
    "./lib/*.js": "./build/lib/*.js",
    "./cli/cmd/*.js": "./build/cli/cmd/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src"
  ],
  "keywords": [
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/startracex/godown.git",
    "directory": "packages/cli"
  },
  "author": "startracex",
  "license": "MIT"
}
