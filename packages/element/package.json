{
  "name": "@godown/element",
  "version": "2.0.0",
  "description": "Component base class for godown",
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "clean": "tsc --build --clean",
    "build": "tsc"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "sharekit": "^1.3.0",
    "tslib": "^2.9.1"
  },
  "exports": {
    ".": "./build/index.js",
    "./src/*": "./src/*",
    "./*.json": "./*.json",
    "./*.js": "./build/*.js",
    "./*": "./build/*.js"
  },
  "files": [
    "**/*.{d.ts,js}+(|.map)",
    "src",
    "tsconfig.json"
  ],
  "keywords": [
    "custom-elements",
    "web-components"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/startracex/godown.git",
    "directory": "packages/element"
  },
  "author": "startracex",
  "license": "MIT"
}
