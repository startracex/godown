@import "./global.styl"

.search-field button,
#storybook-explorer-menu .search-result-item,
#storybook-explorer-menu button,
.sidebar-subheading-action,
.sidebar-header button
  background none !important
  color currentColor !important

.sidebar-item button
  box-shadow: none !important
.sidebar-item:hover
  [data-theme="dark"] &
    background hsl(0deg 0% 10%)

  [data-theme="light"] &
    background hsl(0deg 0% 90%)

[data-testid="tooltip"] *
  color currentColor !important

[data-theme="dark"] [data-testid="tooltip"] button:hover
  background hsl(0deg 0% 10%) !important

#storybook-explorer-menu svg,
#storybook-explorer-tree .sidebar-item svg
  color currentColor

.sidebar-header
  button
    &::after,
    &::before
      content none

#list-item-about,
#list-item-whats-new,
#list-item-documentation,
#list-item-shortcuts
  display none

.sb-bar
  overflow-x hidden !important

  > button
    width 100%

  > div > div
    margin 0

iframe
  background none !important

textarea
  max-height 120px !important

[data-theme="dark"]
  .docblock-code-toggle,
  .sbdocs button,
  .sidebar-container button,
  [role="main"] button
    color hsl(0 0% 78%)

  .rejt-name,
  .rejt-value,
  .rejt-collapsed,
  .rejt-not-collapsed-list-item,
  .rejt-not-collapsed-content,
  [class*="ObjectInspector"],
  [class*="objectInspector"]
    color hsl(0 0% 78%) !important

